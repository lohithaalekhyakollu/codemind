class Solution {
public:
    int subarraysDivByK(vector<int>& nums, int k) {
        int n=nums.size();
        int cnt=0;
        unordered_map<int, int> mpp;
        mpp[0]++;
        int sum=0;
        for(int i=0;i<n;i++)
        {
            sum+=nums[i];
            int need=((sum % k) + k) % k; 
            cnt+=mpp[need];
            mpp[need]++;
        }
        return cnt; 

    }
};
