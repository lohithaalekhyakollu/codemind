int sumOddLengthSubarrays(int* arr, int arrSize) {
    int sum=0;
    for(int i=0;i<arrSize;i++)
    {
        sum+=arr[i];
    }
    for(int i=0;i<arrSize;i++)
    {
        for(int j=i+2;j<arrSize;j=j+2)
        {
            for(int k=i;k<=j;k++)
            {
            sum+=arr[k];
            }
        }
    }
    return sum;
}
